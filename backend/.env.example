# =============================================================================
# MedAI Backend Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# For deployment (Render, Railway, etc.), set these in your dashboard settings.
# =============================================================================

# LLM Providers (At least GROQ_API_KEY is strongly recommended for fast, free inference)
# Get your free Groq API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional Fallbacks:
GOOGLE_API_KEY=your_gemini_api_key_optional
OPENAI_API_KEY=your_openai_api_key_optional

# CORS Allowed Origins (Comma-separated list of frontends allowed to talk to the API)
# For local development:
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# For production (add your Vercel / custom domain):
# ALLOWED_ORIGINS=https://medai-frontend.vercel.app,http://localhost:3000

# Server Runtime Settings
PORT=8000
LOG_LEVEL=INFO
DEBUG=false
TRUSTED_HOSTS=*
